{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=kanban_db;Username=app_user;Password=<db_password>"
  },
  "Hashids": {
    "Salt": "<hashids_salt>",
    "MinHashLength": 10
  },
  "Jwt": {
    "Key": "<jwt_signing_key>",
    "Issuer": "kanbanboard.local",
    "Audience": "kanbanboard.local"
  },
  "SessionHint": {
    "Key": "<session_hint_signing_key>",
    "TtlSeconds": 20,
    "Issuer": "kanbanboard.local",
    "Audience": "kanbanboard.local"
  },
  "Resend": {
    "ApiKey": "<resend_api_key>",
    "FromEmail": "noreply@example.com"
  },
  "Frontend": {
    "BaseUrl": "https://localhost:3000"
  },
  "Cookies": {
    "UseCrossSiteAuth": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [ "https://localhost:3000" ],
  "Sse": {
    "AllowQueryStringToken": false,
    "EnableDistributedRelay": false
  }
}
